# ============================================================
# TracePic 환경 변수 예시 파일
# 사용법: cp .env.example .env  후 실제 값으로 수정 (.env 는 절대 커밋 금지)
# ============================================================

# 실행 환경: development | production
FLASK_ENV=development

# Flask 세션 서명용 비밀키 — 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── MySQL 접속 정보 ──
# 방법 1) URI 한 줄 (설정 시 아래 DB_* 보다 우선). 비밀번호 특수문자(@ : / # 등)는 URL 인코딩 필요
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname?charset=utf8mb4
# 방법 2) 개별 변수
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tracepic
DB_PASSWORD=change-me
DB_NAME=tracepic

# ── DB 커넥션 풀 / 로그인 확인 캐시 (기본값이면 생략 가능) ──
# DB_POOL_SIZE=5            # 워커당 보관할 유휴 커넥션 수
# DB_POOL_RECYCLE=3600      # 이 시간(초)보다 오래된 커넥션은 새로 연결
# DB_POOL_PING_IDLE=60      # 이 시간(초) 이상 쉬었던 커넥션은 ping 확인 후 사용
# AUTH_CACHE_SECONDS=60     # 로그인 확인 결과 캐시(초). 0 이면 매 요청 DB 확인

# ── 이미지 암호화 Master Salt ──
# 사용자ID는 DB에 평문으로 남으므로, 실질적인 비밀은 이 값 하나입니다 (키 = HKDF(MASTER_SALT, user_id)).
# 반드시 32바이트 이상 난수로 생성하고, 분실 시 기존 이미지는 복호화 불가합니다(별도 백업 필수).
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_SALT=change-me

# ── 저장소 / 로그 디렉토리 (프로젝트 외부) ──
# 미설정 시 기본값: 프로젝트 상위 폴더의 ../tracepic_storage , ../tracepic_logs
# 상대 경로는 프로젝트 루트 기준. 운영 서버 예: /home/opc/tracepic_storage
# STORAGE_DIR=../tracepic_storage
# LOG_DIR=../tracepic_logs

# ── 로그인 ──
# DEVICE_TOKEN_DAYS=180     # 기기 토큰·세션 유지 기간(일)
# LOGIN_MAX_FAILS=5         # 아이디당 허용 실패 횟수
# LOGIN_LOCK_MINUTES=10     # 초과 시 잠금 시간(분)

# 업로드 최대 크기(MB) / 웹용 리사이징 최대 변 길이(px) / JPEG 품질
MAX_UPLOAD_MB=30
IMAGE_MAX_SIDE=2048
IMAGE_JPEG_QUALITY=85
